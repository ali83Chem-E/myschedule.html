  }
</style>
</head>
<body>

<h1>روابط ترمودینامیکی</h1>

<!-- بخش ۱ -->
<h2>۱. روابط تعریفی پایه</h2>
<div class="formula">
U = انرژی داخلی<br>
H = U + PV<br>
A = U − TS<br>
G = H − TS<br>
G = A + PV<br>
G = U + PV − TS
</div>

<!-- بخش ۲ -->
<h2>۲. روابط بنیادی (فرم دیفرانسیلی)</h2>
<div class="formula">
dU = T dS − P dV<br>
dH = T dS + V dP<br>
dA = −S dT − P dV<br>
dG = −S dT + V dP
</div>

<!-- بخش ۳ -->
<h2>۳. مشتقات جزئی از روابط بنیادی</h2>
<div class="formula">
(∂U/∂S)<sub>V</sub> = T<br>
(∂U/∂V)<sub>S</sub> = −P<br>
(∂H/∂S)<sub>P</sub> = T<br>
(∂H/∂P)<sub>S</sub> = V<br>
(∂A/∂T)<sub>V</sub> = −S<br>
(∂A/∂V)<sub>T</sub> = −P<br>
(∂G/∂T)<sub>P</sub> = −S<br>
(∂G/∂P)<sub>T</sub> = V
</div>

<!-- بخش ۴ -->
<h2>۴. روابط ماکسول</h2>
<div class="formula">
(∂T/∂V)<sub>S</sub> = −(∂P/∂S)<sub>V</sub><br>
(∂T/∂P)<sub>S</sub> = (∂V/∂S)<sub>P</sub><br>
(∂S/∂V)<sub>T</sub> = (∂P/∂T)<sub>V</sub><br>
(∂S/∂P)<sub>T</sub> = −(∂V/∂T)<sub>P</sub>
</div>

<!-- بخش ۵ -->
<h2>۵. روابط گیبس–هلمهولتز</h2>
<div class="formula">
(∂G/∂T)<sub>P</sub> = −S<br>
(∂(G/T)/∂T)<sub>P</sub> = −H/T²<br>
(∂(A/T)/∂T)<sub>V</sub> = −U/T²
</div>

<!-- بخش ۶ -->
<h2>۶. روابط تغییرات (فرم انتگرالی)</h2>
<div class="formula">
ΔG = ΔH − TΔS<br>
ΔA = ΔU − TΔS<br>
ΔH = ΔU + Δ(PV)<br>
ΔG = ΔA + Δ(PV)<br>
ΔG = ΔA + PΔV &nbsp; (در فشار ثابت)
</div>

<!-- بخش ۷ -->
<h2>۷. روابط ظرفیت گرمایی</h2>
<div class="formula">
C<sub>V</sub> = (∂U/∂T)<sub>V</sub><br>
C<sub>P</sub> = (∂H/∂T)<sub>P</sub><br>
C<sub>P</sub> − C<sub>V</sub> = T (∂P/∂T)<sub>V</sub> (∂V/∂T)<sub>P</sub><br>
C<sub>P</sub> − C<sub>V</sub> = −T (∂P/∂T)<sub>V</sub>² / (∂P/∂V)<sub>T</sub>
</div>

<!-- بخش ۸ -->
<h2>۸. U و H بر حسب ظرفیت گرمایی</h2>
<div class="formula">
dU = C<sub>V</sub> dT + [ T (∂P/∂T)<sub>V</sub> − P ] dV<br>
dH = C<sub>P</sub> dT + [ V − T (∂V/∂T)<sub>P</sub> ] dP
</div>
<div class="note">
برای گاز ایده‌آل: جمله کروشه در dH صفر می‌شود ⇒ dH = C<sub>P</sub> dT
</div>

<!-- بخش ۹ -->
<h2>۹. روابط آنتروپی</h2>
<div class="formula">
dS = (C<sub>V</sub>/T) dT + (∂P/∂T)<sub>V</sub> dV<br>
dS = (C<sub>P</sub>/T) dT − (∂V/∂T)<sub>P</sub> dP
</div>

<!-- بخش ۱۰ -->
<h2>۱۰. شرط خودبه‌خودی بودن و تعادل</h2>
<div class="formula">
در دما و حجم ثابت: &nbsp; dA ≤ 0<br>
در دما و فشار ثابت: &nbsp; dG ≤ 0<br>
شرط تعادل: &nbsp; dA = 0 , d²A &gt; 0 (در T, V ثابت)<br>
شرط تعادل: &nbsp; dG = 0 , d²G &gt; 0 (در T, P ثابت)
</div>

<!-- بخش ۱۱ -->
<h2>۱۱. جمع‌بندی روابط بین چهار پتانسیل</h2>
<div class="formula">
U = A + TS<br>
U = H − PV<br>
H = G + TS<br>
H = U + PV<br>
A = G − PV<br>
A = U − TS<br>
G = H − TS<br>
G = A + PV
</div>
<!-- جدول -->
<h2>۱۲. جدول خلاصه</h2>
<table>
  <tr>
    <th>کمیت</th>
    <th>تعریف</th>
    <th>فرم دیفرانسیلی</th>
    <th>متغیرهای طبیعی</th>
  </tr>
  <tr>
    <td>U</td>
    <td>—</td>
    <td>dU = T dS − P dV</td>
    <td>S, V</td>
  </tr>
  <tr>
    <td>H</td>
    <td>U + PV</td>
    <td>dH = T dS + V dP</td>
    <td>S, P</td>
  </tr>
  <tr>
    <td>A</td>
    <td>U − TS</td>
    <td>dA = −S dT − P dV</td>
    <td>T, V</td>
  </tr>
  <tr>
    <td>G</td>
    <td>H − TS</td>
    <td>dG = −S dT + V dP</td>
    <td>T, P</td>
  </tr>
</table>

