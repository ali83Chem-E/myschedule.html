<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<title>روابط ترمودینامیک</title>
<style>
  body {
    font-family: "B Nazanin", "IRANSans", Tahoma, sans-serif;
    line-height: 1.9;
    max-width: 850px;
    margin: 30px auto;
    padding: 20px;
    color: #000;
    background: #fff;
  }
  h1 {
    text-align: center;
    border-bottom: 3px solid #333;
    padding-bottom: 10px;
    margin-bottom: 25px;
  }
  h2 {
    background: #f0f0f0;
    padding: 8px 12px;
    border-right: 5px solid #444;
    margin-top: 30px;
    font-size: 1.15em;
  }
  .formula {
    direction: ltr;
    text-align: left;
    font-family: "Cambria Math", "Times New Roman", serif;
    font-size: 1.15em;
    background: #fafafa;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 10px 18px;
    margin: 10px 0;
    line-height: 2.2;
  }
  .note {
    background: #fffbe6;
    border-right: 4px solid #e0b400;
    padding: 8px 14px;
    margin: 10px 0;
    font-size: 0.95em;
  }
